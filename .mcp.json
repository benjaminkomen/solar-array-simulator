{
  "mcpServers": {
    "maestro": {
      "command": "maestro",
      "args": [
        "mcp",
        "--working-dir",
        "."
      ]
    },
    "argent": {
      "type": "stdio",
      "command": "argent",
      "args": [
        "mcp"
      ],
      "env": {
        "ARGENT_MCP_LOG": "/Users/benjaminkomen/.argent/mcp-calls.log"
      }
    }
  }
}
